{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/domain/**/*",
    "src/application/**/*",
    "src/infrastructure/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "exclude": ["tests/renderer/**/*"]
}
